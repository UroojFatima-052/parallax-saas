NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/parallax_saas
JWT_SECRET=generate_a_random_string_of_at_least_32_characters

# Generate JWT_SECRET using this command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Stripe Setup
STRIPE_SECRET_KEY=sk_test_your_key
# Get this by running the Stripe CLI (see README):
# stripe listen --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,invoice.paid,invoice.payment_failed --forward-to localhost:5000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_from_stripe_listen
STRIPE_PRICE_PRO=price_for_pro_plan
STRIPE_PRICE_TEAM=price_for_team_plan